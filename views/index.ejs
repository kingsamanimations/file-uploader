<!-- For including the logged in or out navigation -->
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <meta charset="UTF-8">
  <title>File Uploader</title>
</head>
<body class="justify-content-between align-items-center flex-direction-column flex-wrap gap-2 mb-4">
  <%- include("partials/nav") %>
  <h1>File Uploader</h1>
  <% if (locals.currentUser) { %>
    <p>Welcome back, <%= currentUser.username %>!</p>
  <% } else { %>
    <p>Sign up or log in now to upload files.</p>
  <% } %>
</body>
</html>